# Заявки з форми контакту надходять у Telegram.
# 1. Створіть бота в @BotFather і вставте токен.
# 2. Напишіть боту будь-що, відкрийте https://api.telegram.org/bot<TOKEN>/getUpdates
#    і візьміть message.chat.id.
# Локально — у .env.local, на Vercel — у Settings → Environment Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
